# Managed by the repo-standards-review consumer kit (templates/consumer). Change
# the answers in .cruft.json and run `cruft update` rather than editing these
# rules. Add repository-specific rules below the closing line; cruft keeps them.
#
# Executable scripts check out with LF on every platform, including Windows with
# core.autocrlf=true, because a CR breaks their interpreter line. text=auto
# leaves binary files in script directories untouched.
*.sh text eol=lf
.githooks/** text=auto eol=lf
githooks/** text=auto eol=lf
git-hooks/** text=auto eol=lf
.husky/** text=auto eol=lf
.repo-standards-review/** text eol=lf
# The kit's root files keep LF too, so a tree that is hashed or packaged has the
# same bytes on every platform.
.repo-standards-review.json text eol=lf
.cruft.json text eol=lf
*.py text=auto eol=lf
cleanroom/ubuntu-labview/*.ps1 text=auto eol=lf
experiments/multi-vm-topology/**/*.ps1 text=auto eol=lf
# Byte-provenance files keep their exact bytes, whatever the rules above say.
experiments/mesh-stress-signature/fixtures/win-vm-*.json -text
experiments/windows-docker-container/evidence/** -text
# End of the repo-standards-review consumer-kit rules.

# labview-benchmark-actor rules. They come after the kit rules above, so they win for the paths they match.
# Cross-plane parity: the ollama-bus lesson store + bash harness must be BYTE-IDENTICAL on every plane so the
# parity-lock token (sha256 of lba-coordinator.Modelfile) matches on Windows and Linux, and so the harness
# scripts stay LF for the bare Linux container. Force LF regardless of a plane's core.autocrlf setting.
experiments/ollama-bus/lba-coordinator.Modelfile text eol=lf
experiments/ollama-bus/*.sh text eol=lf
cleanroom/ubuntu-labview/*.sh text eol=lf
cleanroom/ubuntu-labview/**/*.sh text eol=lf
experiments/activation/*.sh text eol=lf

# The wiki generator's configuration is read by the generator and gates on every plane; it keeps LF so a Windows
# checkout hashes the same as a Linux one (issue #98: it once shipped in the .vsix as CRLF and broke the cross-plane
# reproduction).
.wiki-generator.json text eol=lf

# Extension-embedded AGENTS.md (issue #98): the manifest pins the file by sha256 over its canonical body, so
# it must stay LF on every plane (a Windows CRLF checkout would otherwise hash differently than the manifest).
extension-agents/AGENTS.md text eol=lf
extension-agents/agents.manifest.json text eol=lf

# Cross-plane .vsix byte-reproducibility (ADR-0067 / LBA-REQ-086): the files packaged into the .vsix -- and the
# experiments/ sources bundled into out/acg-mcp-bundle by stage-acg-mcp -- must be LF on EVERY plane so a Windows
# build and a Linux build of the same commit are byte-identical. *.mjs/*.js/*.md carry no committed CRLF, so LF is
# safe repo-wide; *.json is scoped to the packaged media set to avoid the Windows-captured experiment fixtures
# (experiments/mesh-stress-signature/fixtures/win-vm-*.json are intentionally CRLF and are neither packaged nor bundled).
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.md text eol=lf
/package.json text eol=lf
/release-components.json text eol=lf
/release-risk-baseline.json text eol=lf
/standards-score-baseline.json text eol=lf
/README.md text eol=lf
/CHANGELOG.md text eol=lf
/LICENSE text eol=lf
/.nvmrc text eol=lf
media/*.json text eol=lf
media/icon.png binary

# Retained Windows-container feasibility evidence is hashed byte-for-byte by a
# committed verifier. Preserve the original Windows bytes (including CRLF JSON
# and UTF-16 TightVNC logs) on every checkout.
experiments/windows-docker-container/evidence/** binary
experiments/windows-docker-container/decisions/*.json text eol=lf

# Ubuntu cleanroom provisioners execute under Bash in guests and must retain LF on every host.
cleanroom/ubuntu-labview/*.sh text eol=lf

# Shared CI mesh workers execute under Bash in Linux containers and guests.
# The vendored mprr shared contract is verified by SHA-256 (ADR-0086): keep it byte-exact on every plane.
experiments/mprr-ring/contract/mprr-shared-contract.v1.json -text
