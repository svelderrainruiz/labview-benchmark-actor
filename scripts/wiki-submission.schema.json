{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rsr/wiki-submission@1",
  "description": "A fork's claim that its tests ran at one commit. Every value is data: none is executed, interpolated into a shell, or echoed back. The verifier reads these limits from this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "fork", "fork_commit", "upstream_base", "generator", "platform", "tests", "evidence", "lineage"],
  "properties": {
    "schema": { "const": "rsr/wiki-submission@1" },
    "fork": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}$" },
    "fork_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "upstream_base": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generator": { "type": "string", "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$" },
    "platform": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$" },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
          "result": { "enum": ["passed", "failed", "skipped"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_repo", "source_commit"],
      "properties": {
        "source_repo": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}$" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    }
  },
  "x-limits": { "bodyBytes": 65536, "depth": 6, "fileBytes": 262144, "totalBytes": 1048576 }
}
